# JARA International Website — Environment variables template
# Copy to .env.local for local dev. Cloudflare Pages env vars set via dashboard.
# NEVER commit .env.local or .env.production with real values.

# --- n8n webhook URLs (Sprint 4 — ADR-035 SubmittalForm + ADR-037 DocumentLibrary) ---
# Per Phase 1 constraint C1: PRODUCTION webhooks (NOT /webhook-test/).
N8N_SUBMITTAL_WEBHOOK_URL=https://your-n8n-host/webhook/jara-submittal
N8N_DOCUMENT_REQUEST_WEBHOOK_URL=https://your-n8n-host/webhook/jara-document-request
# Optional shared secret header (sent as X-Webhook-Secret). Leave empty if
# the n8n workflows don't enforce one.
N8N_WEBHOOK_SECRET=

# --- Cloudflare Turnstile (Sprint 4 step 2 — ADR-042 T2 + F1.R10) ---
# DEV DEFAULTS BELOW: Cloudflare's official test keys that ALWAYS pass.
# Use these for local dev (localhost has no real-key allowance).
#
# Production override: paste your real keys into .env.local (gitignored).
# Real keys come from https://dash.cloudflare.com → Turnstile → widget settings.
# Production hostnames are jarainternational.com + jaraintl.com.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Google Search Console verification (DNS TXT also works) ---
GSC_VERIFICATION_CODE=

# --- Bing Webmaster Tools verification ---
BING_VERIFICATION_CODE=

# --- Cloudflare Web Analytics (no token needed for embed beacon) ---
NEXT_PUBLIC_CF_BEACON_TOKEN=

# --- Site config ---
NEXT_PUBLIC_SITE_URL=https://jarainternational.com

# --- OpenRouter (consensus rounds via scripts/consensus_call.py) ---
# Real key lives in .env.local (gitignored). Never commit a real key here.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
